# ============================================
# WORKOUT TRACKER - UNIFIED CONFIG
# ============================================
# Change USE_LOCAL to true to switch to local backend
# Change USE_LOCAL to false to use remote backend
# ============================================

USE_LOCAL=false

# Remote Backend (production)
API_URL_REMOTE=http://0.0l0.0.00.:4000

# Local Backend (development)
API_URL_LOCAL=http://192.168.1.15:4000

# ============================================
# Backend Database Configuration
# ============================================
DATABASE_URL=postgres://postgres:spark@localhost:5432/workout_tracker
PGSSL=false
JWT_SECRET=replace-with-a-long-random-string
PORT=4000
    
# Cloud provider alternatives (uncomment to use):
# DATABASE_URL=postgres://user:pass@host.supabase.co:5432/postgres
# PGSSL=true

# ============================================
# Password Reset Email (Gmail SMTP — temporary transport)
# ============================================
# Use a Gmail APP PASSWORD (account must have 2-Step Verification enabled):
# Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Deep-link scheme of the mobile app (see app.json "scheme"); the emailed
# button becomes  <APP_SCHEME>://reset-password?token=...
APP_SCHEME=workouttracker
# Web fallback base URL if no app scheme is set (leave empty for now)
FRONTEND_URL=
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# ============================================
# GYM WEB PORTAL (gym-web/)
# ============================================
# Copy this file to .env at the repo root — ONE file configures the mobile
# app, the backend and this portal.

# ── Development ──
# Where `npm run dev` (Vite) proxies /auth and /gym. Defaults to
# http://localhost:4000 when unset — no .env needed for local development.
# GYMWEB_PROXY_TARGET=http://localhost:4000

# ── Production build (deploy to a REMOTE backend) ──
# The backend origin baked into the static bundle at build time. Set this
# (or put it in .env.production) before `npm run build`, then upload
# gym-web/dist/ anywhere static. Empty = same-origin deploy behind a
# reverse proxy that forwards /auth and /gym to the backend.
# VITE_API_BASE_URL=https://your-remote-backend.example.com





